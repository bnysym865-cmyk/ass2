      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Load Data & Preprocessing (Titanic Dataset)\n",
        "df = pd.read_csv('tested.csv')\n",
        "\n",
        "features = ['Pclass', 'Age', 'SibSp', 'Parch', 'Fare']\n",
        "df = df[features + ['Survived']].dropna()\n",
        "\n",
        "X = df[features].values\n",
        "y = df['Survived'].values.reshape(-1, 1)\n",
        "\n",
        "# Train / Test Split\n",
        "np.random.seed(42)\n",
        "indices = np.random.permutation(len(X))\n",
        "split = int(0.8 * len(X))\n",
        "X_train, X_test = X[indices[:split]], X[indices[split:]]\n",
        "y_train, y_test = y[indices[:split]], y[indices[split:]]\n",
        "\n",
        "# Standardization\n",
        "mean = X_train.mean(axis=0)\n",
        "std = X_train.std(axis=0) + 1e-8\n",
        "X_train = (X_train - mean) / std\n",
        "X_test = (X_test - mean) / std\n",
        "\n",
        "# Add Bias Term\n",
        "X_train_b = np.c_[np.ones((X_train.shape[0], 1)), X_train]\n",
        "X_test_b = np.c_[np.ones((X_test.shape[0], 1)), X_test]\n",
        "\n",
        "# 2. Helper Functions\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-np.clip(z, -500, 500)))\n",
        "\n",
        "def compute_loss(y_true, y_pred):\n",
        "    eps = 1e-15\n",
        "    y_pred = np.clip(y_pred, eps, 1 - eps)\n",
        "    return -np.mean(y_true * np.log(y_pred) + (1 - y_true) * np.log(1 - y_pred))\n",
        "\n",
        "def evaluate_metrics(y_true, y_prob):\n",
        "    y_pred = (y_prob >= 0.5).astype(int)\n",
        "    tp = np.sum((y_true == 1) & (y_pred == 1))\n",
        "    tn = np.sum((y_true == 0) & (y_pred == 0))\n",
        "    fp = np.sum((y_true == 0) & (y_pred == 1))\n",
        "    fn = np.sum((y_true == 1) & (y_pred == 0))\n",
        "\n",
        "    return {\n",
        "        \"Loss\": compute_loss(y_true, y_prob),\n",
        "        \"Accuracy\": (tp + tn) / len(y_true),\n",
        "        \"Precision\": tp / (tp + fp + 1e-15),\n",
        "        \"Recall\": tp / (tp + fn + 1e-15),\n",
        "        \"F1\": 2 * tp / (2 * tp + fp + fn + 1e-15)\n",
        "    }\n",
        "\n",
        "m, n = X_train_b.shape\n",
        "epochs = 200  # حددنا 200 دورة لتوحيد المقارنة\n",
        "results_summary = {}\n",
        "loss_histories = {}\n",
        "\n",
        "# ==========================================\n",
        "# 1. Batch Gradient Descent\n",
        "# ==========================================\n",
        "w = np.zeros((n, 1))\n",
        "lr = 0.1\n",
        "loss_history = []\n",
        "for _ in range(epochs):\n",
        "    y_pred = sigmoid(X_train_b @ w)\n",
        "    grad = (1 / m) * (X_train_b.T @ (y_pred - y_train))\n",
        "    w -= lr * grad\n",
        "    loss_history.append(compute_loss(y_train, y_pred))\n",
        "loss_histories['Batch GD'] = loss_history\n",
        "results_summary['Batch GD'] = evaluate_metrics(y_test, sigmoid(X_test_b @ w))\n",
        "\n",
        "# ==========================================\n",
        "# 2. Stochastic Gradient Descent (SGD)\n",
        "# ==========================================\n",
        "w = np.zeros((n, 1))\n",
        "lr = 0.01\n",
        "loss_history = []\n",
        "for _ in range(epochs):\n",
        "    indices = np.random.permutation(m)\n",
        "    for i in indices:\n",
        "        xi = X_train_b[i:i+1]\n",
        "        yi = y_train[i:i+1]\n",
        "        y_pred = sigmoid(xi @ w)\n",
        "        grad = xi.T @ (y_pred - yi)\n",
        "        w -= lr * grad\n",
        "    epoch_preds = sigmoid(X_train_b @ w)\n",
        "    loss_history.append(compute_loss(y_train, epoch_preds))\n",
        "loss_histories['SGD'] = loss_history\n",
        "results_summary['SGD'] = evaluate_metrics(y_test, sigmoid(X_test_b @ w))\n",
        "\n",
        "# ==========================================\n",
        "# 3. Mini-Batch Gradient Descent\n",
        "# ==========================================\n",
        "w = np.zeros((n, 1))\n",
        "lr = 0.05\n",
        "batch_size = 32\n",
        "loss_history = []\n",
        "for _ in range(epochs):\n",
        "    indices = np.random.permutation(m)\n",
        "    X_shuff = X_train_b[indices]\n",
        "    y_shuff = y_train[indices]\n",
        "    for i in range(0, m, batch_size):\n",
        "        xb = X_shuff[i:i+batch_size]\n",
        "        yb = y_shuff[i:i+batch_size]\n",
        "        y_pred = sigmoid(xb @ w)\n",
        "        grad = (1 / len(xb)) * (xb.T @ (y_pred - yb))\n",
        "        w -= lr * grad\n",
        "    epoch_preds = sigmoid(X_train_b @ w)\n",
        "    loss_history.append(compute_loss(y_train, epoch_preds))\n",
        "loss_histories['Mini-Batch GD'] = loss_history\n",
        "results_summary['Mini-Batch GD'] = evaluate_metrics(y_test, sigmoid(X_test_b @ w))\n",
        "\n",
        "# ==========================================\n",
        "# 4. RMSprop\n",
        "# ==========================================\n",
        "w = np.zeros((n, 1))\n",
        "s = np.zeros((n, 1))\n",
        "lr = 0.01\n",
        "beta = 0.9\n",
        "eps_val = 1e-8\n",
        "loss_history = []\n",
        "for _ in range(epochs):\n",
        "    y_pred = sigmoid(X_train_b @ w)\n",
        "    grad = (1 / m) * (X_train_b.T @ (y_pred - y_train))\n",
        "    s = beta * s + (1 - beta) * (grad ** 2)\n",
        "    w -= (lr / (np.sqrt(s) + eps_val)) * grad\n",
        "    loss_history.append(compute_loss(y_train, y_pred))\n",
        "loss_histories['RMSprop'] = loss_history\n",
        "results_summary['RMSprop'] = evaluate_metrics(y_test, sigmoid(X_test_b @ w))\n",
        "\n",
        "# ==========================================\n",
        "# 5. Adam\n",
        "# ==========================================\n",
        "w = np.zeros((n, 1))\n",
        "v = np.zeros((n, 1))\n",
        "s = np.zeros((n, 1))\n",
        "lr = 0.01\n",
        "beta1 = 0.9\n",
        "beta2 = 0.999\n",
        "eps_val = 1e-8\n",
        "loss_history = []\n",
        "for t in range(1, epochs + 1):\n",
        "    y_pred = sigmoid(X_train_b @ w)\n",
        "    grad = (1 / m) * (X_train_b.T @ (y_pred - y_train))\n",
        "    v = beta1 * v + (1 - beta1) * grad\n",
        "    s = beta2 * s + (1 - beta2) * (grad ** 2)\n",
        "    v_corr = v / (1 - (beta1 ** t))\n",
        "    s_corr = s / (1 - (beta2 ** t))\n",
        "    w -= (lr / (np.sqrt(s_corr) + eps_val)) * v_corr\n",
        "    loss_history.append(compute_loss(y_train, y_pred))\n",
        "loss_histories['Adam'] = loss_history\n",
        "results_summary['Adam'] = evaluate_metrics(y_test, sigmoid(X_test_b @ w))\n",
        "\n",
        "# ==========================================\n",
        "# Print Comparison Table & Plot Results\n",
        "# ==========================================\n",
        "print(\"=================== OPTIMIZERS COMPARISON TABLE ===================\")\n",
        "comparison_df = pd.DataFrame(results_summary).T\n",
        "print(comparison_df.to_string())\n",
        "print(\"===================================================================\")\n",
        "\n",
        "# Plotting Combined Loss Curves\n",
        "plt.figure(figsize=(10, 6))\n",
        "for name, history in loss_histories.items():\n",
        "    plt.plot(range(epochs), history, label=name, linewidth=2)\n",
        "\n",
        "plt.title('Comparison of Training Loss Curves Across Optimizers')\n",
        "plt.xlabel('Epochs')\n",
        "plt.ylabel('Binary Cross-Entropy Loss')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
