    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Load Data & Preprocessing (Titanic Dataset)\n",
        "df = pd.read_csv('tested.csv')\n",
        "\n",
        "features = ['Pclass', 'Age', 'SibSp', 'Parch', 'Fare']\n",
        "df = df[features + ['Survived']].dropna()\n",
        "\n",
        "X = df[features].values\n",
        "y = df['Survived'].values.reshape(-1, 1)\n",
        "\n",
        "# Train / Test Split\n",
        "np.random.seed(42)\n",
        "indices = np.random.permutation(len(X))\n",
        "split = int(0.8 * len(X))\n",
        "X_train, X_test = X[indices[:split]], X[indices[split:]]\n",
        "y_train, y_test = y[indices[:split]], y[indices[split:]]\n",
        "\n",
        "# Standardization\n",
        "mean = X_train.mean(axis=0)\n",
        "std = X_train.std(axis=0) + 1e-8\n",
        "X_train = (X_train - mean) / std\n",
        "X_test = (X_test - mean) / std\n",
        "\n",
        "# Add Bias Term\n",
        "X_train = np.c_[np.ones((X_train.shape[0], 1)), X_train]\n",
        "X_test = np.c_[np.ones((X_test.shape[0], 1)), X_test]\n",
        "\n",
        "# 2. Helper Functions\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-np.clip(z, -500, 500)))\n",
        "\n",
        "def compute_loss(y_true, y_pred):\n",
        "    eps = 1e-15\n",
        "    y_pred = np.clip(y_pred, eps, 1 - eps)\n",
        "    return -np.mean(y_true * np.log(y_pred) + (1 - y_true) * np.log(1 - y_pred))\n",
        "\n",
        "def evaluate_metrics(y_true, y_prob):\n",
        "    y_pred = (y_prob >= 0.5).astype(int)\n",
        "    tp = np.sum((y_true == 1) & (y_pred == 1))\n",
        "    tn = np.sum((y_true == 0) & (y_pred == 0))\n",
        "    fp = np.sum((y_true == 0) & (y_pred == 1))\n",
        "    fn = np.sum((y_true == 1) & (y_pred == 0))\n",
        "\n",
        "    return {\n",
        "        \"Loss\": compute_loss(y_true, y_prob),\n",
        "        \"Accuracy\": (tp + tn) / len(y_true),\n",
        "        \"Precision\": tp / (tp + fp + 1e-15),\n",
        "        \"Recall\": tp / (tp + fn + 1e-15),\n",
        "        \"F1\": 2 * tp / (2 * tp + fp + fn + 1e-15)\n",
        "    }\n",
        "\n",
        "# 3. RMSprop Training & Tracking Loss\n",
        "m, n = X_train.shape\n",
        "w = np.zeros((n, 1))\n",
        "s = np.zeros((n, 1))  # EMA of squared gradients\n",
        "lr = 0.01\n",
        "beta = 0.9\n",
        "eps_val = 1e-8\n",
        "epochs = 1000\n",
        "loss_history = []  # لتخزين قيمة الـ Loss بعد كل Epoch\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    y_pred = sigmoid(X_train @ w)\n",
        "    grad = (1 / m) * (X_train.T @ (y_pred - y_train))\n",
        "\n",
        "    # RMSprop update equations\n",
        "    s = beta * s + (1 - beta) * (grad ** 2)\n",
        "    w -= (lr / (np.sqrt(s) + eps_val)) * grad\n",
        "\n",
        "    # حساب وتخزين الـ Loss\n",
        "    current_loss = compute_loss(y_train, y_pred)\n",
        "    loss_history.append(current_loss)\n",
        "\n",
        "# 4. Evaluation & Results\n",
        "test_probs = sigmoid(X_test @ w)\n",
        "results = evaluate_metrics(y_test, test_probs)\n",
        "\n",
        "print(\"=== RMSprop Results ===\")\n",
        "for k, v in results.items():\n",
        "    print(f\"{k}: {v:.4f}\")\n",
        "\n",
        "# 5. Plotting Loss Curve\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(range(epochs), loss_history, color='purple', linewidth=2)\n",
        "plt.title('Training Loss Curve (RMSprop)')\n",
        "plt.xlabel('Epochs')\n",
        "plt.ylabel('Binary Cross-Entropy Loss')\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
